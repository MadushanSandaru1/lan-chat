<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lanchat.controller.ChatController" styleClass="chat-panel">
  <HBox spacing="14" alignment="CENTER_LEFT" styleClass="chat-header"><Label fx:id="avatar" text="↔" styleClass="avatar"/><VBox spacing="4"><Label fx:id="title" text="Your network. Your conversation." styleClass="chat-title"/><Label fx:id="subtitle" text="Private conversations, shared locally." styleClass="chat-subtitle"/></VBox><Pane HBox.hgrow="ALWAYS"/><Label text="LAN ONLY" styleClass="pill"/></HBox>
  <ScrollPane fx:id="scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="conversation-scroll"><VBox fx:id="bubbles" fillWidth="true" spacing="12" styleClass="messages"/></ScrollPane>
  <Label fx:id="typing" text=" " styleClass="typing"/>
  <VBox styleClass="composer-area" spacing="10">
    <HBox alignment="CENTER" spacing="12"><TextArea fx:id="input" promptText="Write a message…" prefRowCount="2" wrapText="true" HBox.hgrow="ALWAYS"/><Button fx:id="sendButton" text="Send ↗" onAction="#send" styleClass="send-button"/></HBox>
    <Label text="Enter to send · Shift + Enter for a new line  /  Trusted networks only — traffic is not encrypted" wrapText="true" styleClass="composer-hint"/>
  </VBox>
</VBox>
